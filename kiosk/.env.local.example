# â”€â”€ Kiosk Core â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Secret untuk auth ke Cloudflare Worker (sama dengan KIOSK_SECRET di worker)
KIOSK_SECRET=ganti-ini

# URL Cloudflare Worker yang sudah di-deploy
NEXT_PUBLIC_WORKER_URL=https://semeta-generate.ericyeoung.workers.dev

# URL kiosk ini sendiri â€” pakai IP LAN biar QR video bisa dibuka dari HP tamu
# Contoh: http://192.168.1.10:3000
NEXT_PUBLIC_KIOSK_URL=http://localhost:3000

# â”€â”€ Printer DNP (opsional â€” kalau kosong, fallback ke nama queue default) â”€â”€â”€â”€â”€â”€
# Nama queue Windows yang dibuat setup_printer.ps1. Override cuma buat kiosk
# yang printernya beda nama. Default: RX1-STRIP (paper 2x6 + 2inch cut) & RX1-4R (paper 4x6).
# PRINTER_STRIP=RX1-STRIP
# PRINTER_4R=RX1-4R

# â”€â”€ PocketBase (template source) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Wajib kalau template_source = pocketbase (default)
POCKETBASE_URL=http://localhost:8090
POCKETBASE_EMAIL=admin@example.com
POCKETBASE_PASSWORD=ganti-dengan-password-kuat
