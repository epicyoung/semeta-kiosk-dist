# ── Kiosk Core ────────────────────────────────────────────────────────────────
# Secret untuk auth ke Cloudflare Worker (sama dengan KIOSK_SECRET di worker)
KIOSK_SECRET=ganti-ini

# URL Cloudflare Worker yang sudah di-deploy
NEXT_PUBLIC_WORKER_URL=https://semeta-generate.ericyeoung.workers.dev

# URL kiosk ini sendiri — pakai IP LAN biar QR video bisa dibuka dari HP tamu
# Contoh: http://192.168.1.10:3000
NEXT_PUBLIC_KIOSK_URL=http://localhost:3000

# ── PocketBase (template source) ──────────────────────────────────────────────
# Wajib kalau template_source = pocketbase (default)
POCKETBASE_URL=http://localhost:8090
POCKETBASE_EMAIL=admin@admin.com
POCKETBASE_PASSWORD=admin

# ── Optional ──────────────────────────────────────────────────────────────────
# ComfyUI WebSocket — cuma dipakai kalau engine = ComfyUI
NEXT_PUBLIC_COMFY_URL=ws://localhost:8188/ws
